# CakeStore Storefront & Dashboard - Frontend Environment Template
# Copy to frontend_v2/.env.local for local overrides.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# DO NOT put backend secrets, database passwords, or private API keys in this file.

NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_or_live_key_id
